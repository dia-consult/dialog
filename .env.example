# PostgreSQL, created as a Coolify PostgreSQL service
DATABASE_URL=postgresql://dialog:change-me@postgres:5432/dialog

# Ringostat: set these in Coolify only; never commit real values.
RINGOSTAT_PROJECT_ID=77316
RINGOSTAT_AUTH_KEY=
RINGOSTAT_WEBHOOK_USER=ringostat
RINGOSTAT_WEBHOOK_PASSWORD=
RINGOSTAT_IMPORT_LIMIT=10

# OpenRouter powers transcription and the DIA quality score. Set only in Coolify.
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini
DIALOG_MAX_AUDIO_BYTES=20971520

# Public URL used in webhook instructions
PUBLIC_URL=https://dialog.dia-consulting.com.ua
